    "allow-hotkeys-set",
    "allow-hotkeys-reset",
    "allow-hotkeys-suspend",
    "allow-recorder-get-restart-point",
    "allow-recorder-save-draft",
    "allow-recorder-save-draft-guide",
    "allow-recorder-save-draft-step",
    "allow-recorder-delete-draft-step",
    "allow-recorder-load-draft",
    "allow-settings-read-file",
    "allow-settings-write-file",
    "allow-export-write-file",
    "allow-export-default-folder",
    "allow-export-show",
    "allow-export-preview",
    "allow-brands-list",
    "allow-brands-save",
    "allow-brands-save-managed",

    "allow-updates-install",
    "allow-browser-link-get",
    "allow-browser-link-set",
    "allow-library-list-libraries",
    "allow-library-add-library",
    "allow-library-rename-library",
    "allow-library-remove-library",
    "allow-library-set-default-library",
    "allow-library-list-guides",
    "allow-library-retake-image",
    "allow-library-search-guides",
    "allow-library-load-guide",

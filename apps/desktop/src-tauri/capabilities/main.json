{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: only the commands its UI uses, one permission each, never wildcards (docs/spec/08-privacy-and-security.md#app-hardening).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-recorder-start",
    "allow-recorder-pause",
    "allow-recorder-resume",
    "allow-recorder-stop",
    "allow-recorder-get-preferences",
    "allow-recorder-set-preferences",
    "allow-recorder-get-state",
    "allow-recorder-discard",
    "allow-recorder-set-input-source",
    "allow-recorder-exclude-app",
    "allow-recorder-include-app",
    "allow-recorder-set-capture-mode",
    "allow-recorder-set-bar-hidden",
    "allow-open-web-page",
    "allow-recorder-get-monitors",
    "allow-recorder-set-target-monitor",
    "allow-recorder-append-step",
    "allow-recorder-finalize",
    "allow-recorder-get-recoveries",
    "allow-recorder-recover-session",

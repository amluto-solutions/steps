{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "recorder-bar",
  "description": "The recorder bar: recording controls only. It can't open guides, write files or change settings.",
  "windows": ["recorder-bar"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "allow-recorder-get-state",
    "allow-recorder-discard",
    "allow-recorder-set-input-source",
    "allow-recorder-exclude-app",
    "allow-recorder-capture-now",
    "allow-recorder-pause",
    "allow-recorder-resume",
    "allow-recorder-stop",
    "allow-recorder-add-shortcut",
    "allow-recorder-bar-heartbeat",
    "allow-recorder-start-again",
    "allow-recorder-undo-start-again",
    "allow-recorder-move-bar"
  ]
}

          "Catalan": "nsis/Catalan.nsh",
          "Lithuanian": "nsis/Lithuanian.nsh",
          "Slovenian": "nsis/Slovenian.nsh",
          "Latvian": "nsis/Latvian.nsh",
          "Estonian": "nsis/Estonian.nsh",
          "Irish": "nsis/Irish.nsh"
        }
      },
      "wix": {
        "upgradeCode": "a8772ea5-e41c-5d68-862d-0be9828a10a7",
        "fragmentPaths": ["wix/policy.wxs"],
        "componentGroupRefs": ["PolicyProperties"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMDQ1RkRFNzE2NThDMApSV1RBV0Jibi9VWHdBV293M3p1Nmw5cXJyQlFyK2JvWW91WGt0VXlEay95TzJVL3hwU1FJb3FLUAo=",
      "endpoints": ["https://steps.amluto.com/update/release.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

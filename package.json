{
  "name": "amluto-steps",
  "version": "1.0.0",
  "private": true,
  "description": "Amluto Steps — record a task click by click and turn it into a branded step-by-step guide.",
  "license": "GPL-3.0-or-later",
  "author": "Amluto Solutions Ltd",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "apps/website",
    "apps/chrome",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node scripts/hooks.mjs",
    "dev": "npm run tauri -w @amluto-steps/desktop -- dev",
    "tauri": "npm run tauri -w @amluto-steps/desktop --",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "msix": "node scripts/msix.mjs",
    "attributions": "node scripts/attributions.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.3",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
